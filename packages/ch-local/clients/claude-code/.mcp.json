{
  "mcpServers": {
    "ci-failure-triage": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/launch.js", "start", "--pack", "ci-failure-triage", "--stdio"],
      "env": {
        "COUNTINGHOUSE_GITHUB_TOKEN": "${COUNTINGHOUSE_GITHUB_TOKEN:-}",
        "GITHUB_TOKEN": "${GITHUB_TOKEN:-}"
      }
    }
  }
}
